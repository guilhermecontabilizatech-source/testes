# Copie para deploy/.env (o instalar.sh faz isso por você).
DOMINIO=notas.seuescritorio.com.br
ADMIN_EMAIL=voce@seuescritorio.com.br
ADMIN_SENHA=troque-esta-senha
# Backups diários às 3h (horário de Brasília), guardando 30 dias.
BACKUP_HORA=3
BACKUP_DIAS=30
# Questor Zen: token do webhook (gere com: openssl rand -hex 32) e portal do cliente.
# ZEN_WEBHOOK_TOKEN=
# PORTAL_CLIENTES=1
